PRISM_AGENT_KIT_APP_NAME=PrismAgentKit API
PRISM_AGENT_KIT_ENVIRONMENT=development
PRISM_AGENT_KIT_DEBUG=false
PRISM_AGENT_KIT_API_PREFIX=/api/v1
PRISM_AGENT_KIT_LOG_LEVEL=INFO
PRISM_AGENT_KIT_CORS_ORIGINS=["http://localhost:3000"]

# 留空时使用平台数据目录下的 prism-agent-kit/agent.db
# PRISM_AGENT_KIT_DATABASE_PATH=/absolute/path/to/agent.db

# 本地 API 鉴权令牌。非 test 环境必填；test 环境留空可关闭鉴权。
PRISM_AGENT_KIT_API_TOKEN=

PRISM_AGENT_KIT_DEFAULT_PROMPT_REF=default@1

# 模型配置在应用启动时校验，除 base URL 外均不可留空。
# 对接 DeepSeek 或其他 OpenAI-compatible 服务时必须填写 MODEL_BASE_URL。
PRISM_AGENT_KIT_MODEL_BASE_URL=
PRISM_AGENT_KIT_MODEL_API_KEY=
PRISM_AGENT_KIT_MODEL_NAME=
PRISM_AGENT_KIT_MODEL_CONTEXT_WINDOW=
PRISM_AGENT_KIT_MODEL_MAX_OUTPUT_TOKENS=
# 必须显式指定 tiktoken encoding，例如 cl100k_base。
PRISM_AGENT_KIT_MODEL_TOKEN_ENCODING=
PRISM_AGENT_KIT_MODEL_TIMEOUT_SECONDS=30
# 上下文窗口必须大于最大输出 token 与该安全余量之和。
PRISM_AGENT_KIT_CONTEXT_SAFETY_MARGIN_TOKENS=2048
PRISM_AGENT_KIT_MAX_STEPS=10
# 本地工具执行超时的全局上限, 实际取工具声明与上限的较小值。
PRISM_AGENT_KIT_TOOL_TIMEOUT_SECONDS=30
PRISM_AGENT_KIT_REMOTE_TOOL_TIMEOUT_SECONDS=300
PRISM_AGENT_KIT_WORKER_CONCURRENCY=2
PRISM_AGENT_KIT_SSE_HEARTBEAT_SECONDS=15

# 工作区索引与写入审批
PRISM_AGENT_KIT_WORKSPACE_INDEX_MAX_FILE_BYTES=1048576
PRISM_AGENT_KIT_WORKSPACE_INDEX_MAX_FILES=20000
PRISM_AGENT_KIT_WORKSPACE_TOOL_APPROVAL_TIMEOUT_SECONDS=1800
PRISM_AGENT_KIT_WORKSPACE_REQUIRE_WRITE_APPROVAL=true

# MCP Client
MCP_CONNECT_TIMEOUT_SECONDS=10
MCP_TOOL_TIMEOUT_SECONDS=30
MCP_MAX_RESULT_BYTES=204800
